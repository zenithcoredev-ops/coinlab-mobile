{
  "cli": {
    "version": ">= 24.7.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      }
    },
    "preview": {
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_WIDGET_DIAGNOSTICS": "1",
        "EXPO_PUBLIC_SHOW_ERRORS": "1"
      },
      "android": {
        "buildType": "apk"
      }
    }
  }
}
