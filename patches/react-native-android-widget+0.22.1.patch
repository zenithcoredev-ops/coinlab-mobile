@@ -0,0 +1,67 @@
+package com.reactnativeandroidwidget.builder;
+
+import android.graphics.Color;
+import android.view.View;
+
+import androidx.annotation.Nullable;
+
+import org.json.JSONObject;
+
+/**
+ * A TextWidget whose text is {@link #TEXT_PREFIX} + JSON is drawn empty into the bitmap; RNWidget
+ * puts a live TextClock over its bounds instead, so the time updates every minute without a redraw.
+ * JSON: {"format24Hour": "HH:mm", "format12Hour": "h:mm", "color": "#RRGGBB", "bold": true}
+ */
+public class ClockView {
+    public static final String TEXT_PREFIX = "@@textclock@@";
+
+    private final View view;
+    private final String format24Hour;
+    private final String format12Hour;
+    private final int color;
+    private final boolean bold;
+
+    private ClockView(View view, String format24Hour, String format12Hour, int color, boolean bold) {
+        this.view = view;
+        this.format24Hour = format24Hour;
+        this.format12Hour = format12Hour;
+        this.color = color;
+        this.bold = bold;
+    }
+
+    public static boolean isClockText(@Nullable String text) {
+        return text != null && text.startsWith(TEXT_PREFIX);
+    }
+
+    public static ClockView fromText(View view, String text) throws Exception {
+        JSONObject spec = new JSONObject(text.substring(TEXT_PREFIX.length()));
+        String format24Hour = spec.optString("format24Hour", "HH:mm");
+        return new ClockView(
+            view,
+            format24Hour,
+            spec.optString("format12Hour", format24Hour),
+            Color.parseColor(spec.optString("color", "#FFFFFF")),
+            spec.optBoolean("bold", false)
+        );
+    }
+
+    public View getView() {
+        return view;
+    }
+
+    public String getFormat24Hour() {
+        return format24Hour;
+    }
+
+    public String getFormat12Hour() {
+        return format12Hour;
+    }
+
+    public int getColor() {
+        return color;
+    }
+
+    public boolean isBold() {
+        return bold;
+    }
+}
